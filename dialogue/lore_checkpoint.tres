[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Tablet of the Flames"
pages = PackedStringArray("\"Ahead burns a flame of rest. It does not claim you on its own.\"", "\"Stand before it and press E, or Down, to save. The flame draws you to its centre and closes every wound.\"", "\"If you fall in battle, you wake at the flame where you last saved. Spikes only send you back a few steps.\"", "\"Only beside that flame can you change the arts you call with a direction. Open the inventory there (I or Tab).\"")
