[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Tablet of the Four Arts"
pages = PackedStringArray("\"Nova Burst: a ring of force bursts from you and throws back all who stand near.\"", "\"Spirit Volley: a fan of bolts flies out and seeks your enemies.\"", "\"Ascendant Form: for a while you strike harder, move faster and reach further.\"", "\"Comet Dash: you charge in the direction you aim and burst on impact.\"", "\"Each art needs a different amount of energy. Strike foes with your blade to gather it. When the bar passes an art's mark, that art is ready.\"")
