[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Archivist Mira"
pages = PackedStringArray("Ah, a new arrival. Welcome to the Testing Halls. I keep the records here. Ask, and I will explain what I know.", "Healing first. Hold L (or V) while standing still on the ground. Your stored energy flows into your health while you hold it.", "With no energy left, find a checkpoint flame and rest there. Resting restores your health completely.", "Spikes wound you and throw you back to the last solid ground you stood on. Only when you fall in battle do you wake at the last flame you lit.", "Shards are our currency. Foes drop them, and some lie on the ledges. Spikes swallow any shard that falls on them. Open the inventory (I or Tab) to count yours.", "Your great techniques sit on the number keys, from left to right. The coloured marks on your energy bar show how full it must be for each one.", "You may change those techniques, or leave a key empty, in the inventory. But only beside a lit flame.")
