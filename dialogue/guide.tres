[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Archivist Mira"
pages = PackedStringArray("Ah, a new arrival. Welcome to the Testing Halls. I keep the records here. Ask, and I will explain what I know.", "Healing first. Hold L (or V) while standing on the ground. Your energy drains, and a pale portion of health gathers on your bar.", "Keep holding until that portion turns red. Only then is it yours. If you let go early, or are struck, the energy is lost and you gain nothing.", "Healing needs enough stored energy for a whole portion. Without it, find a checkpoint flame and press E (or Down) to save. Saving restores your health completely.", "Spikes wound you and throw you back to the last solid ground you stood on. Only when you fall in battle do you wake at the flame where you last saved.", "Shards are our currency. Foes drop them, and some lie on the ledges. Spikes swallow any shard that falls on them. Open the inventory (I or Tab) to count yours.", "Your great techniques sit on the number keys, from left to right. The coloured marks on your energy bar show how full it must be for each one.", "You may change those techniques in the inventory, but only beside the flame where you last saved.")
