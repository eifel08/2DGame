[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Archivist Mira"
pages = PackedStringArray("Ah, a new arrival. Welcome to the Testing Halls. I keep the records here. Ask, and I will explain what I know.", "Healing first. Hold L (or V) while standing still on the ground. Your stored energy flows into your health for as long as you hold it.", "If you have no energy, find a checkpoint flame. Stand at it and press E to rest. Resting restores your health completely.", "Checkpoints also mark where you return. If you fall, or touch the spikes, you wake at the last flame you lit.", "Shards are our currency. Defeated foes drop them, and some lie hidden on the ledges. Press I or Tab to see how many you carry.", "Your four great techniques sit on keys 1, 2, 3 and 4. The coloured marks on your energy bar show how much each one needs.", "You may rearrange those techniques in the inventory, but only while resting at a checkpoint. Elsewhere, the loadout is fixed.")
