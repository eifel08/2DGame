[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Hidden Tablet"
pages = PackedStringArray("\"Few strike the walls they pass. You did, and the stone gave way.\"", "\"The heart on the altar beats for whoever finds it. Take it, and your body will hold more life.\"", "\"Other walls may hide other paths. Listen for hollow stone.\"")
