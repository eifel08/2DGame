[resource]
script = ExtResource("1_data")
speaker = "Weathered Tablet"
pages = PackedStringArray("\"Press against a wall while falling, and the stone slows your descent.\"", "\"Leap from the wall to spring away. Hold toward the wall as you leap, and you will swing back to it.\"", "\"So, leap after leap, you can climb even a single wall.\"")
