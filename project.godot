; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2DGame"
config/description="Core engine for a 2D Action-Metroidvania (Godot 4 / GDScript)."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Config="*res://autoload/config.gd"
Events="*res://autoload/events.gd"
Sfx="*res://audio/sfx.tscn"
Settings="*res://autoload/settings.gd"
Saves="*res://autoload/saves.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

